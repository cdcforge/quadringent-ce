    },
    {
      "Sid": "ReadLatestFleetProofOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::example-corp-000000000000-int-example-corp-raw/as400/sales/fleet/console-proof.json"
